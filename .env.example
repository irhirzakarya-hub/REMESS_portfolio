# Vercel Blob Token (Automatically provided by Vercel when adding Blob store to your project)
# For local testing with real Vercel Blob: run `vercel env pull .env.local`
# If omitted locally, the app will safely fall back to local disk storage.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional Admin dashboard password (defaults to 'admin' if not set)
ADMIN_PASSWORD="admin"
